{
  "name": "byjg/authuser",
  "description": "A simple and customizable library for user authentication in PHP applications using a clean repository and service layer architecture.",
  "autoload": {
    "psr-4": {
      "ByJG\\Authenticate\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": ">=8.3 <8.7",
    "byjg/micro-orm": "^7.0",
    "byjg/cache-engine": "^7.0",
    "byjg/jwt-wrapper": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5"
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "psalm": [
      "@composer --working-dir=tools/psalm update --no-interaction",
      "tools/psalm/vendor/bin/psalm --threads=1"
    ]
  },
  "license": "MIT"
}
